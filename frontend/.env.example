# FastAPI backend URL used by the Vite dev/preview proxy.
VITE_API_BASE_URL=http://localhost:8000

# Browser-facing API prefix. Keep this as /api when using the Vite proxy.
# If your deployment enables CORS on the backend, you can set this to the
# backend URL directly, e.g. http://localhost:8000
VITE_API_PATH=/api
